[
 {
  "text": "Every lie you tell crawls out of your mouth as a monster.",
  "start": 0.0,
  "end": 3.16,
  "startFrame": 0,
  "endFrame": 95,
  "words": [
   0,
   11
  ]
 },
 {
  "text": "Say, \"I love your haircut,\" and a moth-sized creature bites you.",
  "start": 3.52,
  "end": 6.54,
  "startFrame": 106,
  "endFrame": 196,
  "words": [
   12,
   22
  ]
 },
 {
  "text": "Nobody lies for long here.",
  "start": 6.82,
  "end": 7.98,
  "startFrame": 205,
  "endFrame": 239,
  "words": [
   23,
   27
  ]
 },
 {
  "text": "You can't hide a monster.",
  "start": 8.28,
  "end": 9.44,
  "startFrame": 248,
  "endFrame": 283,
  "words": [
   28,
   32
  ]
 },
 {
  "text": "Except my dad.",
  "start": 9.72,
  "end": 10.34,
  "startFrame": 292,
  "endFrame": 310,
  "words": [
   33,
   35
  ]
 },
 {
  "text": "He has never had one.",
  "start": 10.62,
  "end": 11.64,
  "startFrame": 319,
  "endFrame": 349,
  "words": [
   36,
   40
  ]
 },
 {
  "text": "People call him Honest Ben.",
  "start": 11.88,
  "end": 13.12,
  "startFrame": 356,
  "endFrame": 394,
  "words": [
   41,
   45
  ]
 },
 {
  "text": "I'm Mia.",
  "start": 13.46,
  "end": 13.82,
  "startFrame": 404,
  "endFrame": 415,
  "words": [
   46,
   47
  ]
 },
 {
  "text": "I'm 11, and I have never heard him fib.",
  "start": 14.06,
  "end": 16.04,
  "startFrame": 422,
  "endFrame": 481,
  "words": [
   48,
   56
  ]
 },
 {
  "text": "Then one night, something started tearing through town.",
  "start": 16.4,
  "end": 18.9,
  "startFrame": 492,
  "endFrame": 567,
  "words": [
   57,
   64
  ]
 },
 {
  "text": "It was the size of a barn.",
  "start": 19.16,
  "end": 20.44,
  "startFrame": 575,
  "endFrame": 613,
  "words": [
   65,
   71
  ]
 },
 {
  "text": "Sixty feet of fur and teeth.",
  "start": 20.94,
  "end": 22.78,
  "startFrame": 628,
  "endFrame": 683,
  "words": [
   72,
   77
  ]
 },
 {
  "text": "It flattened the bakery.",
  "start": 23.1,
  "end": 24.16,
  "startFrame": 693,
  "endFrame": 725,
  "words": [
   78,
   81
  ]
 },
 {
  "text": "It swallowed the mayor's car.",
  "start": 24.44,
  "end": 25.7,
  "startFrame": 733,
  "endFrame": 771,
  "words": [
   82,
   86
  ]
 },
 {
  "text": "At dawn, it vanished.",
  "start": 26.0,
  "end": 27.18,
  "startFrame": 780,
  "endFrame": 815,
  "words": [
   87,
   90
  ]
 },
 {
  "text": "Whose lie could be that big?",
  "start": 27.48,
  "end": 28.98,
  "startFrame": 824,
  "endFrame": 869,
  "words": [
   91,
   96
  ]
 },
 {
  "text": "\"Whoever owns that beast, confess now!\"",
  "start": 29.16,
  "end": 31.26,
  "startFrame": 875,
  "endFrame": 938,
  "words": [
   97,
   102
  ]
 },
 {
  "text": "the mayor shouted.",
  "start": 31.5,
  "end": 32.14,
  "startFrame": 945,
  "endFrame": 964,
  "words": [
   103,
   105
  ]
 },
 {
  "text": "Nobody spoke.",
  "start": 32.54,
  "end": 33.12,
  "startFrame": 976,
  "endFrame": 994,
  "words": [
   106,
   107
  ]
 },
 {
  "text": "So my brother Sam and I followed the claw marks.",
  "start": 33.6,
  "end": 35.64,
  "startFrame": 1008,
  "endFrame": 1069,
  "words": [
   108,
   117
  ]
 },
 {
  "text": "They stopped at our cellar door.",
  "start": 36.04,
  "end": 37.2,
  "startFrame": 1081,
  "endFrame": 1116,
  "words": [
   118,
   123
  ]
 },
 {
  "text": "We opened it.",
  "start": 37.5,
  "end": 38.06,
  "startFrame": 1125,
  "endFrame": 1142,
  "words": [
   124,
   126
  ]
 },
 {
  "text": "Inside, curled around the furnace, was the monster.",
  "start": 38.24,
  "end": 40.78,
  "startFrame": 1147,
  "endFrame": 1223,
  "words": [
   127,
   134
  ]
 },
 {
  "text": "And there was Dad, holding out a bowl of food.",
  "start": 41.08,
  "end": 42.96,
  "startFrame": 1232,
  "endFrame": 1289,
  "words": [
   135,
   144
  ]
 },
 {
  "text": "\"Hello, old friend.\"",
  "start": 43.22,
  "end": 43.88,
  "startFrame": 1297,
  "endFrame": 1316,
  "words": [
   145,
   147
  ]
 },
 {
  "text": "He saw us and went pale.",
  "start": 44.22,
  "end": 45.6,
  "startFrame": 1327,
  "endFrame": 1368,
  "words": [
   148,
   153
  ]
 },
 {
  "text": "\"How long?\"",
  "start": 45.86,
  "end": 46.32,
  "startFrame": 1376,
  "endFrame": 1390,
  "words": [
   154,
   155
  ]
 },
 {
  "text": "I asked.",
  "start": 46.68,
  "end": 47.02,
  "startFrame": 1400,
  "endFrame": 1411,
  "words": [
   156,
   157
  ]
 },
 {
  "text": "\"Nine years.\"",
  "start": 47.38,
  "end": 47.88,
  "startFrame": 1421,
  "endFrame": 1436,
  "words": [
   158,
   159
  ]
 },
 {
  "text": "Nine years.",
  "start": 48.32,
  "end": 48.96,
  "startFrame": 1450,
  "endFrame": 1469,
  "words": [
   160,
   161
  ]
 },
 {
  "text": "Since Mom.",
  "start": 49.32,
  "end": 49.78,
  "startFrame": 1480,
  "endFrame": 1493,
  "words": [
   162,
   163
  ]
 },
 {
  "text": "\"When people ask where she is, I say she's traveling,\" he whispered.",
  "start": 49.94,
  "end": 53.02,
  "startFrame": 1498,
  "endFrame": 1591,
  "words": [
   164,
   175
  ]
 },
 {
  "text": "\"And it grows.\"",
  "start": 53.32,
  "end": 53.92,
  "startFrame": 1600,
  "endFrame": 1618,
  "words": [
   176,
   178
  ]
 },
 {
  "text": "My throat burned.",
  "start": 54.28,
  "end": 55.14,
  "startFrame": 1628,
  "endFrame": 1654,
  "words": [
   179,
   181
  ]
 },
 {
  "text": "Mom wasn't traveling.",
  "start": 55.44,
  "end": 56.3,
  "startFrame": 1663,
  "endFrame": 1689,
  "words": [
   182,
   184
  ]
 },
 {
  "text": "Mom was gone.",
  "start": 56.64,
  "end": 57.38,
  "startFrame": 1699,
  "endFrame": 1721,
  "words": [
   185,
   187
  ]
 },
 {
  "text": "\"Dad, say it.\"",
  "start": 57.74,
  "end": 58.7,
  "startFrame": 1732,
  "endFrame": 1761,
  "words": [
   188,
   190
  ]
 },
 {
  "text": "\"I can't.\"",
  "start": 58.79,
  "end": 59.44,
  "startFrame": 1764,
  "endFrame": 1783,
  "words": [
   191,
   192
  ]
 },
 {
  "text": "The monster opened one yellow eye.",
  "start": 59.66,
  "end": 61.32,
  "startFrame": 1790,
  "endFrame": 1840,
  "words": [
   193,
   198
  ]
 },
 {
  "text": "Outside, sirens.",
  "start": 61.6,
  "end": 62.68,
  "startFrame": 1848,
  "endFrame": 1880,
  "words": [
   199,
   200
  ]
 },
 {
  "text": "The town was coming with torches.",
  "start": 63.04,
  "end": 64.42,
  "startFrame": 1891,
  "endFrame": 1933,
  "words": [
   201,
   206
  ]
 },
 {
  "text": "\"Please,\" I said.",
  "start": 64.81,
  "end": 65.8,
  "startFrame": 1944,
  "endFrame": 1974,
  "words": [
   207,
   209
  ]
 },
 {
  "text": "Dad knelt.",
  "start": 66.12,
  "end": 66.56,
  "startFrame": 1984,
  "endFrame": 1997,
  "words": [
   210,
   211
  ]
 },
 {
  "text": "His voice cracked.",
  "start": 66.86,
  "end": 67.56,
  "startFrame": 2006,
  "endFrame": 2027,
  "words": [
   212,
   214
  ]
 },
 {
  "text": "\"Your mother died.\"",
  "start": 67.84,
  "end": 68.58,
  "startFrame": 2035,
  "endFrame": 2057,
  "words": [
   215,
   217
  ]
 },
 {
  "text": "The monster shuddered.",
  "start": 68.84,
  "end": 69.72,
  "startFrame": 2065,
  "endFrame": 2092,
  "words": [
   218,
   220
  ]
 },
 {
  "text": "It shrank.",
  "start": 69.98,
  "end": 70.5,
  "startFrame": 2099,
  "endFrame": 2115,
  "words": [
   221,
   222
  ]
 },
 {
  "text": "It melted into smoke and drifted up like a sigh.",
  "start": 70.76,
  "end": 73.18,
  "startFrame": 2123,
  "endFrame": 2195,
  "words": [
   223,
   232
  ]
 },
 {
  "text": "Dad pulled us close, and we cried until the sirens faded.",
  "start": 73.5,
  "end": 76.1,
  "startFrame": 2205,
  "endFrame": 2283,
  "words": [
   233,
   243
  ]
 },
 {
  "text": "Then he wiped his eyes and asked, \"Are you two okay?\"",
  "start": 76.42,
  "end": 78.64,
  "startFrame": 2293,
  "endFrame": 2359,
  "words": [
   244,
   254
  ]
 },
 {
  "text": "I smiled.",
  "start": 78.96,
  "end": 79.44,
  "startFrame": 2369,
  "endFrame": 2383,
  "words": [
   255,
   256
  ]
 },
 {
  "text": "\"I'm fine.\"",
  "start": 79.74,
  "end": 80.18,
  "startFrame": 2392,
  "endFrame": 2405,
  "words": [
   257,
   258
  ]
 },
 {
  "text": "Behind me, something huge opened its eyes.",
  "start": 80.48,
  "end": 82.78,
  "startFrame": 2414,
  "endFrame": 2483,
  "words": [
   259,
   265
  ]
 }
]