[
 {
  "text": "I saved my sister's life by calling her an airhead.",
  "start": 0.0,
  "end": 2.54,
  "startFrame": 0,
  "endFrame": 76,
  "words": [
   0,
   9
  ]
 },
 {
  "text": "Literally.",
  "start": 2.8,
  "end": 3.26,
  "startFrame": 84,
  "endFrame": 98,
  "words": [
   10,
   10
  ]
 },
 {
  "text": "You see, in this world, every insult comes true.",
  "start": 3.68,
  "end": 6.18,
  "startFrame": 110,
  "endFrame": 185,
  "words": [
   11,
   19
  ]
 },
 {
  "text": "Poof!",
  "start": 6.36,
  "end": 6.7,
  "startFrame": 191,
  "endFrame": 201,
  "words": [
   20,
   20
  ]
 },
 {
  "text": "And it stays that way until you say sorry.",
  "start": 6.86,
  "end": 8.68,
  "startFrame": 206,
  "endFrame": 260,
  "words": [
   21,
   29
  ]
 },
 {
  "text": "So everybody is super polite.",
  "start": 8.96,
  "end": 10.68,
  "startFrame": 269,
  "endFrame": 320,
  "words": [
   30,
   34
  ]
 },
 {
  "text": "Teachers never call anyone lazy, or the kid would melt into the chair.",
  "start": 11.02,
  "end": 14.08,
  "startFrame": 331,
  "endFrame": 422,
  "words": [
   35,
   47
  ]
 },
 {
  "text": "Football coaches never yell, \"You're slow!\"",
  "start": 14.36,
  "end": 16.18,
  "startFrame": 431,
  "endFrame": 485,
  "words": [
   48,
   53
  ]
 },
 {
  "text": "Because the whole team would turn into turtles.",
  "start": 16.44,
  "end": 18.38,
  "startFrame": 493,
  "endFrame": 551,
  "words": [
   54,
   61
  ]
 },
 {
  "text": "And if you call someone a pig at school, you'd better have a muddy field nearby.",
  "start": 18.64,
  "end": 21.86,
  "startFrame": 559,
  "endFrame": 656,
  "words": [
   62,
   77
  ]
 },
 {
  "text": "I haven't insulted anyone since I was five.",
  "start": 22.2,
  "end": 24.12,
  "startFrame": 666,
  "endFrame": 724,
  "words": [
   78,
   85
  ]
 },
 {
  "text": "That year, I called my grandpa an old fossil, and he spent a week in the museum next to a T-Rex.",
  "start": 24.42,
  "end": 28.64,
  "startFrame": 733,
  "endFrame": 859,
  "words": [
   86,
   106
  ]
 },
 {
  "text": "He liked it there.",
  "start": 28.64,
  "end": 29.6,
  "startFrame": 859,
  "endFrame": 888,
  "words": [
   107,
   110
  ]
 },
 {
  "text": "Too much.",
  "start": 29.88,
  "end": 30.28,
  "startFrame": 896,
  "endFrame": 908,
  "words": [
   111,
   112
  ]
 },
 {
  "text": "Kids at school know I'll never fight back.",
  "start": 30.62,
  "end": 32.5,
  "startFrame": 919,
  "endFrame": 975,
  "words": [
   113,
   120
  ]
 },
 {
  "text": "\"Nerd!\"",
  "start": 32.88,
  "end": 33.14,
  "startFrame": 986,
  "endFrame": 994,
  "words": [
   121,
   121
  ]
 },
 {
  "text": "Poof!",
  "start": 33.58,
  "end": 33.92,
  "startFrame": 1007,
  "endFrame": 1018,
  "words": [
   122,
   122
  ]
 },
 {
  "text": "Glasses.",
  "start": 34.39,
  "end": 34.72,
  "startFrame": 1032,
  "endFrame": 1042,
  "words": [
   123,
   123
  ]
 },
 {
  "text": "\"Shorty!\"",
  "start": 35.0,
  "end": 35.38,
  "startFrame": 1050,
  "endFrame": 1061,
  "words": [
   124,
   124
  ]
 },
 {
  "text": "Poof!",
  "start": 35.66,
  "end": 35.96,
  "startFrame": 1070,
  "endFrame": 1079,
  "words": [
   125,
   125
  ]
 },
 {
  "text": "Two inches gone.",
  "start": 36.22,
  "end": 37.0,
  "startFrame": 1087,
  "endFrame": 1110,
  "words": [
   126,
   128
  ]
 },
 {
  "text": "\"Loser!\"",
  "start": 37.36,
  "end": 37.86,
  "startFrame": 1121,
  "endFrame": 1136,
  "words": [
   129,
   129
  ]
 },
 {
  "text": "Poof!",
  "start": 38.14,
  "end": 38.48,
  "startFrame": 1144,
  "endFrame": 1154,
  "words": [
   130,
   130
  ]
 },
 {
  "text": "A big L on my forehead.",
  "start": 38.66,
  "end": 39.96,
  "startFrame": 1160,
  "endFrame": 1199,
  "words": [
   131,
   136
  ]
 },
 {
  "text": "I said nothing.",
  "start": 40.34,
  "end": 40.88,
  "startFrame": 1210,
  "endFrame": 1226,
  "words": [
   137,
   139
  ]
 },
 {
  "text": "Every day.",
  "start": 41.16,
  "end": 41.68,
  "startFrame": 1235,
  "endFrame": 1250,
  "words": [
   140,
   141
  ]
 },
 {
  "text": "But one night, our house caught fire.",
  "start": 41.94,
  "end": 43.64,
  "startFrame": 1258,
  "endFrame": 1309,
  "words": [
   142,
   148
  ]
 },
 {
  "text": "My big sister was trapped on the roof.",
  "start": 43.88,
  "end": 45.44,
  "startFrame": 1316,
  "endFrame": 1363,
  "words": [
   149,
   156
  ]
 },
 {
  "text": "The firefighters' ladder was too short.",
  "start": 45.7,
  "end": 47.28,
  "startFrame": 1371,
  "endFrame": 1418,
  "words": [
   157,
   162
  ]
 },
 {
  "text": "The flames were climbing.",
  "start": 47.52,
  "end": 48.58,
  "startFrame": 1426,
  "endFrame": 1457,
  "words": [
   163,
   166
  ]
 },
 {
  "text": "She screamed, \"Do something!\"",
  "start": 48.9,
  "end": 50.36,
  "startFrame": 1467,
  "endFrame": 1511,
  "words": [
   167,
   170
  ]
 },
 {
  "text": "Then I noticed something.",
  "start": 50.64,
  "end": 51.82,
  "startFrame": 1519,
  "endFrame": 1555,
  "words": [
   171,
   174
  ]
 },
 {
  "text": "Insults don't just hurt you.",
  "start": 52.06,
  "end": 53.32,
  "startFrame": 1562,
  "endFrame": 1600,
  "words": [
   175,
   179
  ]
 },
 {
  "text": "They change you.",
  "start": 53.44,
  "end": 54.26,
  "startFrame": 1603,
  "endFrame": 1628,
  "words": [
   180,
   182
  ]
 },
 {
  "text": "And maybe, they could save her.",
  "start": 54.4,
  "end": 55.78,
  "startFrame": 1632,
  "endFrame": 1673,
  "words": [
   183,
   188
  ]
 },
 {
  "text": "I took a deep breath and yelled the meanest thing I'd ever said.",
  "start": 55.91,
  "end": 59.04,
  "startFrame": 1677,
  "endFrame": 1771,
  "words": [
   189,
   201
  ]
 },
 {
  "text": "\"You're such a chicken!\"",
  "start": 59.28,
  "end": 60.36,
  "startFrame": 1778,
  "endFrame": 1811,
  "words": [
   202,
   205
  ]
 },
 {
  "text": "Poof!",
  "start": 60.74,
  "end": 61.04,
  "startFrame": 1822,
  "endFrame": 1831,
  "words": [
   206,
   206
  ]
 },
 {
  "text": "She turned into a chicken.",
  "start": 61.3,
  "end": 62.32,
  "startFrame": 1839,
  "endFrame": 1870,
  "words": [
   207,
   211
  ]
 },
 {
  "text": "She flapped.",
  "start": 62.66,
  "end": 63.18,
  "startFrame": 1880,
  "endFrame": 1895,
  "words": [
   212,
   213
  ]
 },
 {
  "text": "Flap, flap, flap!",
  "start": 63.52,
  "end": 63.92,
  "startFrame": 1906,
  "endFrame": 1918,
  "words": [
   214,
   216
  ]
 },
 {
  "text": "But chickens can't really fly.",
  "start": 64.1,
  "end": 65.52,
  "startFrame": 1923,
  "endFrame": 1966,
  "words": [
   217,
   221
  ]
 },
 {
  "text": "She was falling.",
  "start": 65.78,
  "end": 66.5,
  "startFrame": 1973,
  "endFrame": 1995,
  "words": [
   222,
   224
  ]
 },
 {
  "text": "\"You're an airhead!\"",
  "start": 66.82,
  "end": 67.78,
  "startFrame": 2005,
  "endFrame": 2033,
  "words": [
   225,
   227
  ]
 },
 {
  "text": "Poomp!",
  "start": 68.16,
  "end": 68.48,
  "startFrame": 2045,
  "endFrame": 2054,
  "words": [
   228,
   228
  ]
 },
 {
  "text": "Her head blew up like a giant balloon.",
  "start": 68.78,
  "end": 70.52,
  "startFrame": 2063,
  "endFrame": 2116,
  "words": [
   229,
   236
  ]
 },
 {
  "text": "She floated in the air like a parade float.",
  "start": 70.82,
  "end": 72.54,
  "startFrame": 2125,
  "endFrame": 2176,
  "words": [
   237,
   245
  ]
 },
 {
  "text": "But the wind started pulling her right back into the smoke.",
  "start": 72.7,
  "end": 75.14,
  "startFrame": 2181,
  "endFrame": 2254,
  "words": [
   246,
   256
  ]
 },
 {
  "text": "\"You're as dumb as a rock!\"",
  "start": 75.38,
  "end": 76.72,
  "startFrame": 2261,
  "endFrame": 2302,
  "words": [
   257,
   262
  ]
 },
 {
  "text": "Bonk!",
  "start": 77.0,
  "end": 77.36,
  "startFrame": 2310,
  "endFrame": 2321,
  "words": [
   263,
   263
  ]
 },
 {
  "text": "She turned to stone and dropped straight down onto the firefighters' trampoline.",
  "start": 77.62,
  "end": 80.9,
  "startFrame": 2329,
  "endFrame": 2427,
  "words": [
   264,
   275
  ]
 },
 {
  "text": "Boing!",
  "start": 81.12,
  "end": 81.56,
  "startFrame": 2434,
  "endFrame": 2447,
  "words": [
   276,
   276
  ]
 },
 {
  "text": "She was safe.",
  "start": 81.9,
  "end": 82.56,
  "startFrame": 2457,
  "endFrame": 2477,
  "words": [
   277,
   279
  ]
 },
 {
  "text": "A rock, a chicken, and a balloon.",
  "start": 82.86,
  "end": 84.7,
  "startFrame": 2486,
  "endFrame": 2541,
  "words": [
   280,
   286
  ]
 },
 {
  "text": "But safe.",
  "start": 84.91,
  "end": 85.46,
  "startFrame": 2547,
  "endFrame": 2564,
  "words": [
   287,
   288
  ]
 },
 {
  "text": "Then came the hardest part.",
  "start": 85.66,
  "end": 87.08,
  "startFrame": 2570,
  "endFrame": 2612,
  "words": [
   289,
   293
  ]
 },
 {
  "text": "\"I'm sorry you're a chicken.\"",
  "start": 87.4,
  "end": 88.34,
  "startFrame": 2622,
  "endFrame": 2650,
  "words": [
   294,
   298
  ]
 },
 {
  "text": "\"I'm sorry you're an airhead.\"",
  "start": 88.72,
  "end": 89.82,
  "startFrame": 2662,
  "endFrame": 2695,
  "words": [
   299,
   303
  ]
 },
 {
  "text": "\"And I'm really sorry you're a rock.\"",
  "start": 90.14,
  "end": 91.84,
  "startFrame": 2704,
  "endFrame": 2755,
  "words": [
   304,
   310
  ]
 },
 {
  "text": "Poof!",
  "start": 92.18,
  "end": 92.44,
  "startFrame": 2765,
  "endFrame": 2773,
  "words": [
   311,
   311
  ]
 },
 {
  "text": "Poof!",
  "start": 92.6,
  "end": 92.76,
  "startFrame": 2778,
  "endFrame": 2783,
  "words": [
   312,
   312
  ]
 },
 {
  "text": "Poof!",
  "start": 92.96,
  "end": 93.28,
  "startFrame": 2789,
  "endFrame": 2798,
  "words": [
   313,
   313
  ]
 },
 {
  "text": "My sister was back.",
  "start": 93.52,
  "end": 94.46,
  "startFrame": 2806,
  "endFrame": 2834,
  "words": [
   314,
   317
  ]
 },
 {
  "text": "She hugged me so hard, my glasses fell off.",
  "start": 94.8,
  "end": 96.82,
  "startFrame": 2844,
  "endFrame": 2905,
  "words": [
   318,
   326
  ]
 },
 {
  "text": "Then she smiled and said, \"Thanks, nerd.\"",
  "start": 97.06,
  "end": 99.06,
  "startFrame": 2912,
  "endFrame": 2972,
  "words": [
   327,
   333
  ]
 },
 {
  "text": "Poof!",
  "start": 99.42,
  "end": 99.78,
  "startFrame": 2983,
  "endFrame": 2993,
  "words": [
   334,
   334
  ]
 },
 {
  "text": "New glasses.",
  "start": 99.98,
  "end": 100.44,
  "startFrame": 2999,
  "endFrame": 3013,
  "words": [
   335,
   336
  ]
 }
]